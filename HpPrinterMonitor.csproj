<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Metadata -->
    <PackageId>HpPrinterMonitor</PackageId>
    <Version>1.0.0</Version>
    <Authors>HP Printer Monitor Contributors</Authors>
    <Company>HP Printer Monitor</Company>
    <Description>A .NET Class Library for monitoring HP Printer telemetry using the SNMP protocol. Retrieves total page count and ink/toner levels.</Description>
    <PackageTags>snmp,hp,printer,monitor,telemetry</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/codebyallan/HpPrinterMonitor</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
